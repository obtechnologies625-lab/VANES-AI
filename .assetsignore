# Wrangler skips anything matched here when uploading static assets.
# Same syntax as .gitignore. The assets directory is the repo root, so
# without this file the Worker source, CI config and DB schema get
# published as public static files.

# Created inside the checkout by the CI wrangler install
node_modules/
.wrangler/

# Source, config and docs that must never be served as static assets
.git/
.github/
src/
functions/
api/
docs/
google-apps-script/
DATABASE_SETUP.md
FIREBASE_SETUP.md
schema.sql
firestore.rules
wrangler.toml
vercel.json
.assetsignore

# 365 KB README-only poster; GitHub serves it, the Worker has no reason to.
assets/ob-tech-labs-brand.jpg
