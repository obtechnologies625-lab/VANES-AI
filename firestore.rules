rules_version = '2';

// Paste this into Firebase console → Build → Firestore Database → Rules → Publish.
// A learner can read and write only their own document; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /learners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // The app syncs a fixed set of keys plus timestamps. Reject writes that try to
      // claim somebody else's identity or grow the document past Firestore's 1 MiB.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'email', 'name', 'phone', 'provider', 'createdAt',
                        'lastSignInAt', 'data', 'syncedAt', 'premium', 'quota'
                      ])
                   && (request.resource.data.email == resource.data.email
                       || request.resource.data.email == request.auth.token.email
                       || !request.resource.data.keys().hasAny(['email']))
                   && request.resource.size() < 950000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
